// Level 3: "The Drowned Library", behind the Choir of Thorns (lvl2) — south and south-east of it.
// World metres (x east, y = world z, growing south). Format: see src/level/layout.rs.
//
// The grid holds one floor per cell, so the three floors are terraced side by side; tall rooms
// below, galleries beside them, joined by ladders that top out through archways in the shared wall.
//
// Route: the Choir's south door (lvl2 door 17, unsealed by the Saint's death) → the Ink Stair →
// FLOOR 1, the Flooded Stacks (−4): readers with their backs turned, hounds in the corners.
//   West wall: ladder up → FLOOR 2, the West Gallery (+2) → illusory wall (strike it) → the
//   Forbidden Reading Room (reward). → South Gallery (dart plates; a Mourner) → East Stacks
//   (swinging censers) → East Gallery (sunflower 31; one-way door down the Long Stair to the
//   Cistern Passage and the hall: the shortcut).
//   East Gallery: ladder up → FLOOR 3, the Archive Antechamber (+8, sunflower 32) → fog → the
//   Orrery: the Archivist.
(
    name: "The Drowned Library",
    px_per_m: 1.0,
    origin_px: (0.0, 0.0),
    origin_world: (0.0, 0.0),
    theme: Library,
    ceiling: Some(20.0),
    seed_base: 700,
    rooms: [
        (name: "Ink Stair", floor: -4.0, height: Some(4.5), rects: [(-1.5, 160.0, 1.5, 166.0)]),
        (name: "Flooded Stacks", floor: -4.0, height: Some(12.0), rects: [(-16.0, 166.0, 16.0, 200.0)]),
        (name: "Cistern Passage", floor: -4.0, height: Some(5.0), rects: [(16.0, 192.0, 22.0, 200.0)]),
        (name: "West Gallery", floor: 2.0, height: Some(6.0), rects: [(-28.0, 166.0, -16.0, 200.0)]),
        (name: "Forbidden Reading Room", floor: 2.0, height: Some(4.5), rects: [(-36.0, 180.0, -28.0, 190.0)]),
        (name: "South Gallery", floor: 2.0, height: Some(6.0), rects: [(-28.0, 200.0, 28.0, 210.0)]),
        (name: "East Stacks", floor: 2.0, height: Some(6.0), rects: [(22.0, 176.0, 28.0, 200.0)]),
        (name: "East Gallery", floor: 2.0, height: Some(10.0), rects: [(16.0, 164.0, 28.0, 176.0)]),
        (name: "Archive Antechamber", floor: 8.0, height: Some(5.0), ambience: Some(Archive), rects: [(16.0, 152.0, 30.0, 164.0)]),
        (name: "The Orrery", floor: 8.0, height: Some(12.0), ambience: Some(Archive), rects: [(30.0, 140.0, 56.0, 170.0)]),
    ],
    stairs: [
        (rect: (16.0, 176.0, 22.0, 192.0), down: South, top: 2.0, bottom: -4.0),
    ],
    doors: [
        // The other half of lvl2's door 17 (the Choir's south door).
        (id: 31, at: (0.0, 160.0), width: 2.6, hinge: West, opens: South, arch: true),
        // The Ink Stair opens into the hall.
        (id: 41, at: (0.0, 166.0), width: 2.6, hinge: West, opens: South, arch: true),
        // Top of the west ladder (floor 1 → 2).
        (id: 32, at: (-16.0, 176.0), width: 1.6, hinge: North, opens: West, arch: true),
        // Hall → cistern passage.
        (id: 33, at: (16.0, 196.0), width: 2.6, hinge: North, opens: East),
        // East Gallery → down the Long Stair: opens only from the gallery (the shortcut).
        (id: 34, at: (19.0, 176.0), width: 2.6, hinge: West, opens: South),
        (id: 35, at: (-22.0, 200.0), width: 3.0, hinge: West, opens: South, arch: true),
        (id: 36, at: (25.0, 200.0), width: 3.0, hinge: West, opens: North, arch: true),
        (id: 37, at: (25.0, 176.0), width: 3.0, hinge: West, opens: North, arch: true),
        // The secret: an archway the illusory wall stands in.
        (id: 38, at: (-28.0, 185.0), width: 2.0, hinge: North, opens: West, arch: true),
        // Top of the east ladder (floor 2 → 3).
        (id: 39, at: (22.0, 164.0), width: 1.6, hinge: West, opens: North, arch: true),
        // Antechamber → the Orrery (the fog gate stands in it).
        (id: 40, at: (30.0, 158.0), width: 3.0, hinge: North, opens: East, arch: true),
    ],
    ladders: [
        (at: (-15.2, 176.0), facing: West, bottom: -4.0, top: 2.0),
        (at: (22.0, 164.8), facing: North, bottom: 2.0, top: 8.0),
    ],
    torches: [
        (at: (-1.2, 163.0), wall: West),
