        (kind: Bookshelf, at: (6.0, 190.0), facing: East, size: (8.0, 5.0)),
        (kind: Bookshelf, at: (10.5, 190.0), facing: East, size: (8.0, 5.0)),
        (kind: Desk, at: (0.0, 182.0), facing: North),
        (kind: Desk, at: (-8.0, 184.0), facing: North),
        (kind: BookPile, at: (2.5, 181.0)), (kind: BookPile, at: (-13.5, 196.0)), (kind: BookPile, at: (13.0, 168.5)),
        (kind: Chandelier, at: (0.0, 172.0)), (kind: Chandelier, at: (0.0, 192.0)),
        (kind: Plaque, at: (2.0, 167.5), facing: South, text: "THE DROWNED LIBRARY. | Here the Saint's order kept every name it ever wrote, and every name it crossed out. | When the cistern broke, the keepers would not leave their books. | Read quietly."),
        // ── Floor 2: the galleries ──
        (kind: Bookshelf, at: (-27.3, 176.0), facing: East, size: (12.0, 4.0)),
