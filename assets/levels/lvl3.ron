        (at: (-20.0, 209.7), wall: South), (at: (0.0, 209.7), wall: South), (at: (20.0, 209.7), wall: South),
        (at: (27.7, 180.0), wall: East), (at: (27.7, 196.0), wall: East),
        (at: (27.7, 170.0), wall: East), (at: (16.3, 168.0), wall: West),
        (at: (16.3, 158.0), wall: West), (at: (29.7, 154.0), wall: East),
        (at: (30.3, 146.0), wall: West), (at: (55.7, 150.0), wall: East), (at: (55.7, 162.0), wall: East), (at: (43.0, 169.7), wall: South), (at: (43.0, 140.3), wall: North),
    ],
    enemies: [
        // Floor 1: readers at their desks (backs to the door), one wandering the aisles.
        (kind: Scribe, at: (0.0, 180.6), facing: Some(South)),
        (kind: Scribe, at: (-8.0, 182.6), facing: Some(South)),
        (kind: Scribe, at: (8.0, 170.0), patrol: Some((8.0, 196.0))),
        (kind: Hollow, at: (-13.0, 170.0)),
        (kind: PageHound, at: (12.0, 197.0)),
        (kind: PageHound, at: (-12.0, 197.0)),
        // Floor 2: the West Gallery.
        (kind: Scribe, at: (-22.0, 172.0), facing: Some(South)),
        (kind: Acolyte, at: (-20.0, 192.0), patrol: Some((-25.0, 170.0))),
        // The South Gallery: a Mourner among the dart plates, two scribes.
        (kind: Mourner, at: (0.0, 205.0)),
        (kind: Scribe, at: (-15.0, 205.0), facing: Some(West)),
        (kind: Scribe, at: (15.0, 204.0), patrol: Some((22.0, 207.0))),
        // The East Stacks: a hound beyond the censers.
        (kind: PageHound, at: (25.0, 179.0)),
        // The East Gallery.
        (kind: Scribe, at: (26.0, 166.0), facing: Some(West)),
        // Floor 3: the Archivist.
        (kind: Archivist, at: (45.0, 152.0), drops: [(item: ArchivistQuill, unique: Some(410))]),
    ],
    treasures: [
        (id: 330, item: HopCone, at: (-14.5, 198.5)),
        (id: 331, item: Poppy, at: (-2.0, 198.5)),
        (id: 332, item: InkboundRobe, at: (-34.0, 185.0)),
        (id: 333, item: HopCone, at: (-34.5, 181.5)),
        (id: 334, item: Camomile, at: (26.5, 198.5)),
        (id: 335, item: HopCone, at: (27.0, 165.0)),
    ],
    sunflowers: [
