    props: [
        // The Cervix: a membrane to cut through, eggs for light.
        (kind: Ova, at: (21.0, 1.0)),
        (kind: Membrane, at: (25.0, 0.0), facing: East, size: (3.2, 3.4)),
        (kind: Sinews, at: (28.0, 0.0)),
