        (kind: Sinews, at: (44.0, 0.0)), (kind: Sinews, at: (52.0, -5.0)), (kind: Sinews, at: (52.0, 5.0)), (kind: Sinews, at: (60.0, 0.0)),
        (kind: Sinews, at: (48.0, 11.0)), (kind: Sinews, at: (56.0, -12.0)),
        // The Ovary.
        (kind: Ova, at: (46.0, -17.0)), (kind: Ova, at: (54.0, -17.0)), (kind: Ova, at: (50.0, -21.0)), (kind: Ova, at: (54.5, -24.5)),
        (kind: Sinews, at: (50.0, -18.0)),
