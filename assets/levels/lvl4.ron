        (kind: BilePool, at: (74.0, -3.75), size: (19.5, 4.4)),
        (kind: BilePool, at: (74.0, 3.75), size: (19.5, 4.4)),
        (kind: Sinews, at: (68.0, 0.0)), (kind: Sinews, at: (74.0, 0.0)), (kind: Sinews, at: (80.0, 0.0)),
