// Level 2: "The Cathedral of Ashes", south of the arena. Coordinates are world metres
// (x east, y = world z, growing south); the arena's south wall is at y = 18.
// Format: see src/level/layout.rs. Rects are (x0, y0, x1, y1).
//
// Route: arena door 11 → narthex (sunflower 11) → great doors 12 → nave + aisles → transept.
//   West: stairs down to the ossuary (Bell of Bones, weeping statue).
//   East: door 14 → cloister (fountain, Bell of the Drowned, sunflower 12) → stairs up → bell
//   chapel (glass-sun window, Bell of the Glass Sun) → gallery → one-way door 15 back into the
//   nave's east aisle (shortcut).
//   South: the apse (altar, the riddle's lectern) → sealed door 13 (ring the bells in order) →
//   crypt stairs → crypt → antechamber (sunflower 13) → fog gate → the Choir of Thorns (boss).
(
    name: "The Cathedral of Ashes",
    px_per_m: 1.0,
    origin_px: (0.0, 0.0),
    origin_world: (0.0, 0.0),
    theme: Gothic,
    ceiling: Some(10.0),
    seed_base: 500,
    rooms: [
        (name: "Narthex", floor: 0.0, rects: [(-1.5, 18.0, 1.5, 24.0), (-7.0, 24.0, 7.0, 32.0)]),
        (name: "Cathedral", floor: 0.0, rects: [
            (-7.0, 32.0, 7.0, 76.0),     // the nave
            (-13.0, 36.0, -7.0, 72.0),   // west aisle
            (7.0, 36.0, 13.0, 72.0),     // east aisle
            (-26.0, 76.0, 26.0, 86.0),   // transept
            (-8.0, 86.0, 8.0, 96.0),     // apse
        ]),
        (name: "Ossuary", floor: -3.0, ambience: Some(Crypt), height: Some(6.0), rects: [(-52.0, 66.0, -34.0, 96.0)]),
        (name: "Cloister", floor: 0.0, rects: [(26.0, 62.0, 52.0, 100.0)]),
        (name: "Bell Chapel", floor: 2.5, rects: [(30.0, 40.0, 50.0, 54.0), (20.0, 45.0, 30.0, 49.0)]),
        (name: "Crypt", floor: -4.0, ambience: Some(Crypt), height: Some(5.5), rects: [(-8.0, 108.0, 8.0, 124.0), (-4.0, 124.0, 4.0, 132.0)]),
        (name: "Choir of Thorns", floor: -4.0, ambience: Some(Boss), height: Some(10.0), rects: [(-15.0, 136.0, 15.0, 156.0), (-11.0, 132.0, 11.0, 160.0)]),
    ],
    stairs: [
        (rect: (-34.0, 78.0, -26.0, 84.0), down: West, top: 0.0, bottom: -3.0),
        (rect: (36.0, 54.0, 42.0, 62.0), down: South, top: 2.5, bottom: 0.0),
        (rect: (13.0, 45.0, 20.0, 49.0), down: West, top: 2.5, bottom: 0.0),
        (rect: (-1.75, 96.0, 1.75, 108.0), down: South, top: 0.0, bottom: -4.0),
    ],
    doors: [
        // Arena → narthex.
        (id: 11, at: (0.0, 18.0), width: 2.6, hinge: East, opens: South),
        // The great doors of the nave.
        (id: 12, at: (0.0, 32.0), width: 3.0, hinge: West, opens: South),
        // Apse → crypt stairs: sealed by the rite of the three bells.
        (id: 13, at: (0.0, 96.0), width: 2.6, hinge: East, opens: South, sealed: true),
        // Transept → cloister.
        (id: 14, at: (26.0, 81.0), width: 2.6, hinge: North, opens: East),
        // Gallery stairs → east aisle: opens only from the gallery (the shortcut back).
        (id: 15, at: (13.0, 47.0), width: 2.6, hinge: North, opens: West),
        // Antechamber → the Choir of Thorns: an archway; the fog gate stands in it.
        (id: 16, at: (0.0, 132.0), width: 3.0, hinge: West, opens: South, arch: true),
        // The Choir's south door: the way on into the Drowned Library (lvl3), sealed until the
